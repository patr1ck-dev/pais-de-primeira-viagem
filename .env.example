# Copie para .env.local e preencha. NUNCA commite o .env.local.

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
# Use as credenciais de TESTE (começam com TEST-) enquanto estiver em sandbox.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Segredo da assinatura do webhook. No painel do Mercado Pago:
# Suas integrações > sua aplicação > Webhooks > "Segredo de assinatura".
# Sem isso qualquer um pode forjar uma confirmação de pagamento.
MERCADOPAGO_WEBHOOK_SECRET=

# Resend — https://resend.com/api-keys
# O domínio do remetente precisa estar VERIFICADO no painel, senão o envio
# só funciona para o e-mail da própria conta.
RESEND_API_KEY=
EMAIL_FROM="Pais de Primeira Viagem <guia@seudominio.com.br>"

# Segredo para assinar os links de download (HMAC).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_TOKEN_SECRET=

# URL pública do site (sem barra final). Ex.: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Copie para .env.local e preencha. NUNCA commite o .env.local.

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
# Use as credenciais de TESTE enquanto estiver em sandbox.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Segredo para assinar os links de download (HMAC).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_TOKEN_SECRET=

# URL pública do site (sem barra final). Ex.: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
